<Window x:Class="CybersecurityAwarenessBot.Part3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessBot.Part3"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot"
        Height="760" Width="920"
        MinHeight="600" MinWidth="720"
        Background="{StaticResource BgDark}"
        ContentRendered="Window_ContentRendered">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
            CornerRadius="10" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="AsciiHeader"
                   FontFamily="Consolas" FontSize="12"
                   Foreground="{StaticResource AccentGreen}"
                   HorizontalAlignment="Center"/>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1">

            <TabItem x:Name="ChatTab" Header="Chat">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                        CornerRadius="10" Padding="8">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatPanel" Margin="4"/>
                        </ScrollViewer>
                    </Border>

                   
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox" Grid.Column="0"
                             FontSize="14" Padding="10"
                             BorderThickness="0"
                             Background="{StaticResource BgPanel}"
                             Foreground="{StaticResource TextLight}"
                             CaretBrush="{StaticResource AccentGreen}"
                             KeyDown="InputBox_KeyDown"/>

                        <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                            Margin="10,0,0,0"
                            Style="{StaticResource SendButtonStyle}"
                            Click="SendButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tasks tab: add cybersecurity tasks with an optional reminder, then complete or delete them. -->
            <TabItem x:Name="TasksTab" Header="Tasks">
                <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Cybersecurity Tasks" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="TasksSummary" Text="Loading your tasks..." Style="{StaticResource SubtleText}"/>
                        </StackPanel>

                        <!-- Form for adding a task -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Style="{StaticResource SubtleText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TaskTitleBox" Grid.Row="1" Grid.Column="0" MaxLength="100" Style="{StaticResource FormTextBox}"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Reminder date (optional)" Style="{StaticResource SubtleText}" Margin="12,0,0,4"/>
                            <DatePicker x:Name="ReminderPicker" Grid.Row="1" Grid.Column="1" Width="190" Margin="12,0,0,0"
                                        FontSize="14" VerticalContentAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Description (optional)" Style="{StaticResource SubtleText}" Margin="0,10,0,4"/>
                            <TextBox x:Name="TaskDescriptionBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" MaxLength="500" Style="{StaticResource FormTextBox}"/>

                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TaskMessage" Grid.Column="0" FontSize="13" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                                <Button x:Name="AddTaskButton" Grid.Column="1" Content="Add task"
                                        Style="{StaticResource SendButtonStyle}" Click="AddTaskButton_Click"/>
                            </Grid>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TaskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TaskCard" Background="{StaticResource BgDark}" CornerRadius="8" Padding="14,10" Margin="0,0,6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock x:Name="TaskTitleText" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" Foreground="{StaticResource TextLight}"/>
                                                    <TextBlock x:Name="TaskDescriptionText" Text="{Binding Description}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextLight}" Opacity="0.75" Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock x:Name="ReminderLabel" Text="{Binding ReminderText}" FontSize="12"
                                                                   Foreground="{StaticResource AccentGreen}"/>
                                                        <TextBlock x:Name="DueBadge" Text="   Due now" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentRed}" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="CompletedBadge" Text="   Completed" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentGreen}" Visibility="Collapsed"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="CompleteButton" Content="Complete" Tag="{Binding}" Margin="0,0,8,0"
                                                            Style="{StaticResource CompleteButtonStyle}" Click="CompleteTask_Click"/>
                                                    <Button Content="Delete" Tag="{Binding}"
                                                            Style="{StaticResource DeleteButtonStyle}" Click="DeleteTask_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter TargetName="TaskTitleText" Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter TargetName="TaskCard" Property="Opacity" Value="0.6"/>
                                                <Setter TargetName="CompleteButton" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CompletedBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDue}" Value="True">
                                                <Setter TargetName="ReminderLabel" Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                <Setter TargetName="DueBadge" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                <Setter TargetName="TaskDescriptionText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="TasksEmpty" Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                                   Text="No tasks yet. Add one above, for example 'Enable two-factor authentication'."
                                   Style="{StaticResource PlaceholderText}"/>
                    </Grid>
                </Border>
            </TabItem>


            <TabItem x:Name="QuizTab" Header="Quiz">
                <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="20">
                    <Grid>
                        <StackPanel x:Name="QuizStartPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                            <TextBlock Text="Cybersecurity Quiz" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SubtleText}" TextAlignment="Center" Margin="0,4,0,20"
                                       Text="Test what you know about phishing, passwords, safe browsing, social engineering and more. Questions are shown one at a time, with feedback after each answer."/>
                            <Button x:Name="StartQuizButton" Content="Start quiz" HorizontalAlignment="Center"
                                    Style="{StaticResource SendButtonStyle}" Click="StartQuizButton_Click"/>
                        </StackPanel>

                        <Grid x:Name="QuizQuestionPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock x:Name="QuizProgress" Style="{StaticResource SubtleText}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="QuizScore" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold"
                                           FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock x:Name="QuestionText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextLight}" Margin="0,0,0,16"/>

                                    <StackPanel x:Name="OptionsPanel"/>

                                    <Border x:Name="FeedbackBorder" CornerRadius="8" Padding="14,10" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="14"
                                                   Foreground="{StaticResource BgDark}"/>
                                    </Border>

                                    <Button x:Name="NextButton" Content="Next question" HorizontalAlignment="Right" Margin="0,14,0,0"
                                            Visibility="Collapsed" Style="{StaticResource SendButtonStyle}" Click="NextButton_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel x:Name="QuizResultPanel" Visibility="Collapsed" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" MaxWidth="560">
                            <TextBlock Text="Quiz complete!" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FinalScoreText" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextLight}" Margin="0,8,0,8"/>
                            <TextBlock x:Name="FinalFeedbackText" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource AccentGreen}" Margin="0,0,0,20"/>
                            <Button x:Name="PlayAgainButton" Content="Play again" HorizontalAlignment="Center"
                                    Style="{StaticResource SendButtonStyle}" Click="StartQuizButton_Click"/>
                        </StackPanel>

                    </Grid>
                </Border>
            </TabItem>

            <TabItem x:Name="LogTab" Header="Activity Log">
                <Border Background="{StaticResource BgPanel}" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="LogSummary" Style="{StaticResource SubtleText}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="LogList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDark}" CornerRadius="8"
                                                Padding="12,8" Margin="0,0,6,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Time, StringFormat={}{0:HH:mm}}"
                                                           FontFamily="Consolas" FontSize="13"
                                                           Foreground="{StaticResource AccentGreen}"
                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Description}"
                                                           FontSize="14" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextLight}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="LogEmpty" Grid.Row="1"
                                   Text="Nothing has been logged yet. Chat with the bot, take the quiz or add a task, and the actions will appear here."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Style="{StaticResource PlaceholderText}"/>

                        <Button x:Name="ShowMoreButton" Grid.Row="2" Content="Show more"
                                HorizontalAlignment="Center" Margin="0,12,0,0"
                                Style="{StaticResource SendButtonStyle}"
                                Click="ShowMoreButton_Click"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
